{
   "author": "Kerim Demirel",
   "manifest_version": 3,
   "name": "Tureng Dictionary",
   "short_name": "Tureng",
   "description": "Tureng English-Turkish Online Dictionary",
   "version": "7.1.1",

   "action": {
      "default_icon": {
         "128": "images/AppIcon.png",
         "256": "images/AppIcon.png"
      },
      "default_popup": "popup.html",
      "default_title": "Tureng Dictionary"
   },
   
   "icons": {
      "128": "images/AppIcon.png",
      "16": "images/AppIcon.png",
      "256": "images/AppIcon.png"
   },

   "permissions": [ "activeTab", "contextMenus", "scripting", "storage", "tts" ],
   "host_permissions": [ "https://tureng.com/*", "https://www.tureng.com/*" ],

   "background": {
      "service_worker":  "scripts/background.js" 
   },
   "content_scripts": [
      {
         "matches": [ "http://*/*", "https://*/*" ],
         "js": [ "scripts/content.js" ],
         "run_at": "document_idle"
      }
   ],

   "options_page": "info.html",

   "commands": {
      "_execute_action": {
         "suggested_key": {
            "chromeos": "Alt+V",
            "default": "Alt+V",
            "linux": "Alt+V",
            "mac": "Alt+V",
            "windows": "Alt+V"
         }
      },
      "show-translation-popup": {
         "suggested_key": {
            "chromeos": "Alt+T",
            "default": "Alt+T",
            "linux": "Alt+T",
            "mac": "Alt+T",
            "windows": "Alt+T"
         },
         "description": "Show Tureng popup for selected word"
      }
   },


   "omnibox": {
      "keyword": "ms"
   }
}
